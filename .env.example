# Copier ce fichier en .env puis adapter les valeurs. Ne jamais commiter .env.

# Base de données MariaDB (≥ 10.11). Format : mysql://utilisateur:motdepasse@hôte:port/base
DATABASE_URL="mysql://ressources:changez-moi@localhost:3306/ressources_peda"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET="à-générer"
# Nécessaire derrière un reverse proxy (hébergement auto-géré)
AUTH_TRUST_HOST=true

# URL publique de l'application (liens dans les courriels)
APP_URL="http://localhost:3000"

# Courriel (facultatif) : sans SMTP_HOST, les courriels sont écrits dans le journal de l'application.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="RessourcesPéda <no-reply@exemple.sn>"

# Mot de passe des comptes de démonstration créés par `npm run db:seed`
DEMO_PASSWORD="choisir-un-mot-de-passe-de-demo"

# Variables utilisées par docker-compose.yml (service MariaDB)
MARIADB_ROOT_PASSWORD="changez-moi-root"
MARIADB_PASSWORD="changez-moi"
